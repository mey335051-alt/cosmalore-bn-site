---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="পাসওয়ার্ড ভুলে গেছেন" description="Cosmalore অ্যাকাউন্টের পাসওয়ার্ড রিসেট করুন">
  <div class="auth-page">
    <h1>পাসওয়ার্ড ভুলে গেছেন</h1>
    <p class="auth-hint">
      আপনার ইমেইল দিন; এই ইমেইল আমাদের কাছে নিবন্ধিত থাকলে পাসওয়ার্ড রিসেটের
      একটি লিঙ্ক পাঠানো হবে।
    </p>

    <form id="forgotForm" class="auth-form">
      <label>
        ইমেইল
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <button type="submit" id="forgotSubmit">রিসেট লিঙ্ক পাঠান</button>
    </form>

    <p id="forgotSuccess" class="auth-success" hidden>
      এই ইমেইল আমাদের কাছে নিবন্ধিত থাকলে কয়েক মিনিটের মধ্যে পাসওয়ার্ড রিসেটের
      লিঙ্কসহ একটি বার্তা পাবেন। স্প্যাম (Spam) ফোল্ডারও দেখে নিন।
    </p>

    <p class="auth-switch"><a href="/login">লগইনে ফিরে যান</a></p>
  </div>
</BaseLayout>

<style>
  .auth-page {
    max-width: 380px;
    margin: var(--space-8) auto;
    padding: var(--space-5);
  }
  h1 { font-size: var(--text-xl); margin-bottom: var(--space-3); text-align: center; }
  .auth-hint { font-size: var(--text-sm); color: var(--color-muted); text-align: center; margin-bottom: var(--space-5); }
  .auth-form { display: flex; flex-direction: column; gap: var(--space-4); }
  label { display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }
  input {
    padding: var(--space-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-family: var(--font-body);
    background: var(--color-panel);
    color: var(--color-ink);
  }
  input:focus { border-color: var(--color-accent); }
  button[type="submit"] {
    padding: var(--space-3);
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
  }
  button[type="submit"][disabled] { opacity: 0.6; cursor: not-allowed; }
  .auth-success {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 10%, var(--color-bg));
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .auth-switch { text-align: center; margin-top: var(--space-5); font-size: var(--text-sm); color: var(--color-muted); }
  .auth-switch a { color: var(--color-accent); }
</style>

<script>
  import { requestPasswordReset } from "../lib/auth.js";

  function initForgotPasswordPage() {
    const form = document.getElementById("forgotForm") as HTMLFormElement | null;
    if (!form) return;
    const submitBtn = document.getElementById("forgotSubmit") as HTMLButtonElement;
    const successEl = document.getElementById("forgotSuccess") as HTMLElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = "পাঠানো হচ্ছে…";
      const data = new FormData(form);
      await requestPasswordReset(String(data.get("email")));
      form.hidden = true;
      successEl.hidden = false;
    });
  }

  document.addEventListener("astro:page-load", initForgotPasswordPage);
</script>
