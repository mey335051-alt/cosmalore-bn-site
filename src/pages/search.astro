---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
---

<BaseLayout title="অনুসন্ধান" description="বিশ্বকোষের সব নিবন্ধে খুঁজুন">
  <div class="search-page">
    <input
      type="search"
      id="searchInput"
      class="search-input"
      placeholder="আপনি কী খুঁজছেন?"
      autofocus
    />

    <p id="searchStatus" class="search-status" aria-live="polite"></p>

    <div id="searchResults" class="article-grid"></div>
  </div>
</BaseLayout>

<style>
  .search-page {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-5);
  }
  .search-input {
    width: 100%;
    padding: var(--space-4);
    font-size: var(--text-lg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    color: var(--color-ink);
    font-family: var(--font-body);
  }
  .search-input:focus { border-color: var(--color-accent); }
  .search-status {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin: var(--space-3) 0 var(--space-5);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  /* استایل کارت‌ها این‌جا global شده چون نتایج جستجو با JS خام
     ساخته می‌شن، نه با کامپوننت Astro (که CSS اسکوپ‌شده داره) */
  .article-grid :global(.article-card) {
    display: block;
    background: var(--color-panel);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .article-grid :global(.article-card:hover) {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .article-grid :global(.img-wrap) {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .article-grid :global(.card-body) { padding: var(--space-4); }
  .article-grid :global(.category-tag) {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: #fff;
    background: var(--color-accent-2);
    padding: 2px var(--space-2);
    border-radius: 999px;
    margin-bottom: var(--space-2);
  }
  .article-grid :global(.card-title) {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-1);
    line-height: var(--line-tight);
  }
  .article-grid :global(.card-excerpt) {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    var input = document.getElementById("searchInput");
    var status = document.getElementById("searchStatus");
    var results = document.getElementById("searchResults");
    var DATA = [];
    var loaded = false;

    function cardHTML(item) {
      // نکته‌ی رفع مشکل ایندکس گوگل: باید هماهنگ با /${trailingSlash}
      // در ArticleCard.astro و sitemap.xml.js باشه، وگرنه همین لینک
      // جستجو هم یه ریدایرکت ۳۰۱ اضافه می‌سازه.
      var href = item.path
        ? "/" + item.path.split("/").map(encodeURIComponent).join("/") + "/"
        : "/" + encodeURIComponent(item.slug) + "/";
      var img = item.image
        ? '<div class="img-wrap"><img src="' + item.image + '" alt="" loading="lazy" width="320" height="180"></div>'
        : "";
      var cat = item.category
        ? '<span class="category-tag">' + item.category + "</span>"
        : "";
      return (
        '<a href="' + href + '" class="article-card">' +
        img +
        '<div class="card-body">' + cat +
        '<h3 class="card-title">' + item.title + "</h3>" +
        '<p class="card-excerpt">' + item.excerpt + "</p>" +
        "</div></a>"
      );
    }

    // باید دقیقاً همون قانونی باشه که build-search-index.js موقع build
    // برای nt/ne/nc اعمال می‌کنه (NFC + حذف ZWJ/ZWNJ + ارقام بنگالی → لاتین).
    function normalizeBengali(s) {
      return (s || "")
        .toString()
        .normalize("NFC")
        .replace(/[\u200B-\u200D\uFEFF]/g, "")
        .replace(/[\u09E6-\u09EF]/g, function (d) { return String(d.charCodeAt(0) - 0x09E6); })
        .toLowerCase()
        .trim();
    }

    // امتیازدهی: تطابق کامل/شروع‌شدنِ عنوان بیشترین وزن رو داره، بعد
    // شامل‌بودنِ عنوان، بعد دسته، بعد توضیح مختصر — نتیجه‌ها بر اساس
    // این امتیاز مرتب می‌شن، نه ترتیب خام آرایه.
    function scoreItem(item, q) {
      var nt = item.nt || "";
      var ne = item.ne || "";
      var nc = item.nc || "";
      if (nt === q) return 100;
      if (nt.indexOf(q) === 0) return 80;
      if (nt.indexOf(q) !== -1) return 60;
      if (nc.indexOf(q) !== -1) return 35;
      if (ne.indexOf(q) !== -1) return 20;
      return 0;
    }

    function search(query) {
      if (!query.trim()) {
        results.innerHTML = "";
        status.textContent = "ফলাফল দেখতে লেখা শুরু করুন…";
        return;
      }
      var q = normalizeBengali(query);
      var matches = DATA
        .map(function (item) {
          return { item: item, score: scoreItem(item, q) };
        })
        .filter(function (m) {
          return m.score > 0;
        })
        .sort(function (a, b) {
          return b.score - a.score;
        })
        .map(function (m) {
          return m.item;
        });
      status.textContent = matches.length
        ? matches.length + "টি ফলাফল পাওয়া গেছে"
        : "কিছু পাওয়া যায়নি";
      results.innerHTML = matches.map(cardHTML).join("");
      if (window.cosmaloreInitImages) window.cosmaloreInitImages();
    }

    async function loadIndex() {
      try {
        var res = await fetch("/search-index.json");
        DATA = await res.json();
        loaded = true;
        var params = new URLSearchParams(window.location.search);
        var initialQ = params.get("q") || "";
        if (initialQ) {
          input.value = initialQ;
          search(initialQ);
        } else {
          status.textContent = "ফলাফল দেখতে লেখা শুরু করুন…";
        }
      } catch (e) {
        status.textContent = "অনুসন্ধান সূচি লোড করতে ত্রুটি হয়েছে।";
      }
    }

    input.addEventListener("input", function () {
      if (loaded) search(input.value);
    });

    loadIndex();
  })();
</script>
