---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="নতুন পাসওয়ার্ড দিন" description="Cosmalore অ্যাকাউন্টের জন্য নতুন পাসওয়ার্ড দিন">
  <div class="auth-page">
    <h1>নতুন পাসওয়ার্ড দিন</h1>

    <form id="resetForm" class="auth-form">
      <label>
        নতুন পাসওয়ার্ড
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
      </label>
      <label>
        পাসওয়ার্ড নিশ্চিত করুন
        <input type="password" name="confirm" required minlength="8" autocomplete="new-password" />
      </label>
      <p id="resetError" class="form-error" hidden></p>
      <button type="submit" id="resetSubmit">পাসওয়ার্ড সংরক্ষণ করুন</button>
    </form>

    <p id="resetSuccess" class="auth-success" hidden>
      পাসওয়ার্ড সফলভাবে পরিবর্তন হয়েছে। এখন <a href="/login">লগইন</a> করতে পারেন।
    </p>

    <p id="resetInvalid" class="form-error" hidden>
      রিসেট লিঙ্কটি অবৈধ অথবা এর মেয়াদ শেষ হয়ে গেছে।
      <a href="/forgot-password">নতুন লিঙ্কের জন্য অনুরোধ করুন</a>।
    </p>
  </div>
</BaseLayout>

<style>
  .auth-page {
    max-width: 380px;
    margin: var(--space-8) auto;
    padding: var(--space-5);
  }
  h1 { font-size: var(--text-xl); margin-bottom: var(--space-5); text-align: center; }
  .auth-form { display: flex; flex-direction: column; gap: var(--space-4); }
  label { display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }
  input {
    padding: var(--space-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-family: var(--font-body);
    background: var(--color-panel);
    color: var(--color-ink);
  }
  input:focus { border-color: var(--color-accent); }
  button[type="submit"] {
    padding: var(--space-3);
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
  }
  button[type="submit"][disabled] { opacity: 0.6; cursor: not-allowed; }
  .form-error { color: #b3261e; font-size: var(--text-sm); margin-top: var(--space-4); }
  .form-error a, .auth-success a { color: var(--color-accent); }
  .auth-success {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 10%, var(--color-bg));
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
</style>

<script>
  import { resetPassword } from "../lib/auth.js";

  function initResetPasswordPage() {
    const form = document.getElementById("resetForm") as HTMLFormElement | null;
    if (!form) return;
    const errorEl = document.getElementById("resetError") as HTMLElement;
    const successEl = document.getElementById("resetSuccess") as HTMLElement;
    const invalidEl = document.getElementById("resetInvalid") as HTMLElement;
    const submitBtn = document.getElementById("resetSubmit") as HTMLButtonElement;

    const params = new URLSearchParams(window.location.search);
    const key = params.get("key");
    const login = params.get("login");

    if (!key || !login) {
      form.hidden = true;
      invalidEl.hidden = false;
      return;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const data = new FormData(form);
      const password = String(data.get("password"));
      const confirm = String(data.get("confirm"));

      if (password !== confirm) {
        errorEl.textContent = "দুটি পাসওয়ার্ড মিলছে না।";
        errorEl.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "সংরক্ষণ হচ্ছে…";
      try {
        await resetPassword(login, key, password);
        form.hidden = true;
        successEl.hidden = false;
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : "অজানা ত্রুটি";
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = "পাসওয়ার্ড সংরক্ষণ করুন";
      }
    });
  }

  document.addEventListener("astro:page-load", initResetPasswordPage);
</script>
