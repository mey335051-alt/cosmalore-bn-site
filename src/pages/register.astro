---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="অ্যাকাউন্ট খুলুন" description="Cosmalore-এ নতুন ব্যবহারকারী অ্যাকাউন্ট খুলুন">
  <div class="auth-page">
    <h1>অ্যাকাউন্ট খুলুন</h1>
    <form id="registerForm" class="auth-form">
      <label>
        নাম
        <input type="text" name="name" required autocomplete="name" />
      </label>
      <label>
        ইমেইল
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        পাসওয়ার্ড
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
      </label>
      <p id="registerError" class="form-error" hidden></p>
      <button type="submit" id="registerSubmit">অ্যাকাউন্ট খুলুন</button>
    </form>
    <p class="auth-switch">ইতিমধ্যে অ্যাকাউন্ট আছে? <a href="/login">লগইন করুন</a></p>
  </div>
</BaseLayout>

<style>
  .auth-page {
    max-width: 380px;
    margin: var(--space-8) auto;
    padding: var(--space-5);
  }
  h1 { font-size: var(--text-xl); margin-bottom: var(--space-5); text-align: center; }
  .auth-form { display: flex; flex-direction: column; gap: var(--space-4); }
  label { display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }
  input {
    padding: var(--space-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-family: var(--font-body);
    background: var(--color-panel);
    color: var(--color-ink);
  }
  input:focus { border-color: var(--color-accent); }
  button[type="submit"] {
    padding: var(--space-3);
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
  }
  button[type="submit"]:hover { background: var(--color-accent-hover); }
  button[type="submit"][disabled] { opacity: 0.6; cursor: not-allowed; }
  .form-error { color: #b3261e; font-size: var(--text-sm); margin: 0; }
  .auth-switch { text-align: center; margin-top: var(--space-5); font-size: var(--text-sm); color: var(--color-muted); }
  .auth-switch a { color: var(--color-accent); }
</style>

<script>
  import { register } from "../lib/auth.js";

  function initRegisterPage() {
    const form = document.getElementById("registerForm") as HTMLFormElement | null;
    if (!form) return;
    const errorEl = document.getElementById("registerError") as HTMLElement;
    const submitBtn = document.getElementById("registerSubmit") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = "অ্যাকাউন্ট খোলা হচ্ছে…";

      const data = new FormData(form);
      try {
        await register(
          String(data.get("email")),
          String(data.get("password")),
          String(data.get("name"))
        );
        window.location.href = "/saved";
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : "অজানা ত্রুটি";
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = "অ্যাকাউন্ট খুলুন";
      }
    });
  }

  document.addEventListener("astro:page-load", initRegisterPage);
</script>
