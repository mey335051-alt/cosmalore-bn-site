---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="লগইন" description="Cosmalore অ্যাকাউন্টে লগইন করুন">
  <div class="auth-page">
    <h1>লগইন</h1>
    <form id="loginForm" class="auth-form">
      <label>
        ইমেইল
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        পাসওয়ার্ড
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <p id="loginError" class="form-error" hidden></p>
      <button type="submit" id="loginSubmit">লগইন</button>
    </form>
    <p class="auth-switch">অ্যাকাউন্ট নেই? <a href="/register">অ্যাকাউন্ট খুলুন</a></p>
    <p class="auth-switch"><a href="/forgot-password">পাসওয়ার্ড ভুলে গেছেন?</a></p>
  </div>
</BaseLayout>

<style>
  .auth-page {
    max-width: 380px;
    margin: var(--space-8) auto;
    padding: var(--space-5);
  }
  h1 { font-size: var(--text-xl); margin-bottom: var(--space-5); text-align: center; }
  .auth-form { display: flex; flex-direction: column; gap: var(--space-4); }
  label { display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-muted); }
  input {
    padding: var(--space-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-family: var(--font-body);
    background: var(--color-panel);
    color: var(--color-ink);
  }
  input:focus { border-color: var(--color-accent); }
  button[type="submit"] {
    padding: var(--space-3);
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
  }
  button[type="submit"]:hover { background: var(--color-accent-hover); }
  button[type="submit"][disabled] { opacity: 0.6; cursor: not-allowed; }
  .form-error { color: #b3261e; font-size: var(--text-sm); margin: 0; }
  .auth-switch { text-align: center; margin-top: var(--space-5); font-size: var(--text-sm); color: var(--color-muted); }
  .auth-switch a { color: var(--color-accent); }
</style>

<script>
  import { login } from "../lib/auth.js";

  function initLoginPage() {
    const form = document.getElementById("loginForm") as HTMLFormElement | null;
    if (!form) return;
    const errorEl = document.getElementById("loginError") as HTMLElement;
    const submitBtn = document.getElementById("loginSubmit") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = "লগইন হচ্ছে…";

      const data = new FormData(form);
      try {
        await login(String(data.get("email")), String(data.get("password")));
        window.location.href = "/saved";
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : "অজানা ত্রুটি";
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = "লগইন";
      }
    });
  }

  document.addEventListener("astro:page-load", initLoginPage);
</script>
