  h2 { font-size: var(--text-lg); color: var(--color-ink); margin-top: var(--space-6); margin-bottom: var(--space-3); }
  p { font-size: var(--text-base); line-height: var(--line-loose); color: var(--color-ink); }
  a { color: var(--color-accent); }
</style>
