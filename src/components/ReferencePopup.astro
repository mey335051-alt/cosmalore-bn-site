---
// پاپ‌آپ منابع — نسخه‌ی قوی‌شده‌ی پلاگین قبلی.
// تفاوت کلیدی: URL واقعی هیچ‌وقت روی href یا هر attribute قابل‌دیدن
// نمی‌شینه؛ فقط داخل یه JSON مجزا نگه داشته می‌شه و فقط لحظه‌ی کلیک
// با window.open باز می‌شه. هاور کردن (دسکتاپ) هیچ آدرسی لو نمی‌ده.

interface Reference {
  n: string;
  title: string;
  author: string;
  year: string;
  url: string;
  domain: string;
  occurrences?: number;
}

interface Note {
  n: number;
  text: string;
  occId: string;
}

interface Props {
  references: Reference[];
  notes?: Note[];
}

const { references, notes = [] } = Astro.props;
const sorted = [...references].sort(
  (a, b) => (Number(a.n) || 0) - (Number(b.n) || 0) || a.n.localeCompare(b.n)
);
---

{references.length > 0 && (
  <section class="ref-bibliography" id="refBiblio">
    <button type="button" class="ref-biblio-toggle" aria-expanded="false">
      <span>সূত্র ও তথ্যসূত্র</span>
      <span class="ref-arrow" aria-hidden="true">⌃</span>
    </button>
    <div class="ref-biblio-body" hidden>
      <ol>
        {sorted.map((r) => (
          <li id={`refItem${r.n}`}>
            <span class="ref-num">{r.n}.</span>
            <span class="ref-meta">
              <strong>{r.author || r.domain || "অজানা উৎস"}</strong>
              {" "}
              <span class="ref-year">({r.year || "তারিখ নেই"})</span>.{" "}
              <em>{r.title || r.domain || "শিরোনাম নেই"}</em>
              {r.hasLink
                ? (r.domain && <span class="ref-domain">. {r.domain}</span>)
                : <span class="ref-badge-book" title="মুদ্রিত উৎস (লিঙ্ক নেই)">📖 মুদ্রিত উৎস</span>}
              {" "}
              {Array.from({ length: r.occurrences || 1 }).map((_, i) => (
                <a
                  href={`#refOcc-${r.n}-${i}`}
                  class="ref-backlink"
                  data-target={`refOcc-${r.n}-${i}`}
                >
                  {(r.occurrences || 1) > 1 ? `↑${i + 1}` : "↑"}
                </a>
              ))}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{notes.length > 0 && (
  <section class="ref-bibliography note-bibliography" id="noteBiblio">
    <button type="button" class="ref-biblio-toggle" aria-expanded="false">
      <span>টীকা</span>
      <span class="ref-arrow" aria-hidden="true">⌃</span>
    </button>
    <div class="ref-biblio-body" hidden>
      <ol>
        {notes.map((note) => (
          <li id={`noteItem${note.n}`}>
            <span class="ref-num">{note.n}.</span>
            <span class="ref-meta">
              {note.text}{" "}
              <a href={`#${note.occId}`} class="ref-backlink" data-target={note.occId}>↑</a>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- دیتای منابع فقط این‌جا، جدا از هر href — فقط با کلیک استفاده می‌شه -->
<script type="application/json" id="refData" set:html={JSON.stringify(sorted)} />
<script type="application/json" id="noteData" set:html={JSON.stringify(notes)} />

<!-- کارت یادداشت — همون ظاهر کارت منابع بدون‌لینک، چون یادداشت هم
     متن کوتاه بدون آدرس خارجی است -->
<div id="noteOverlay" class="ref-overlay ref-overlay-nl" hidden></div>
<div id="noteCard" class="ref-card-nl" role="dialog" aria-modal="true">
  <div class="ref-sheet-handle"></div>
  <button type="button" id="noteCardClose" aria-label="বন্ধ করুন">×</button>
  <div class="ref-card-nl-body">
    <div class="ref-card-nl-icon" aria-hidden="true">📝</div>
    <div id="noteCardLabel" class="ref-card-nl-label"></div>
    <div id="noteCardText" class="ref-card-nl-title"></div>
  </div>
</div>

<!-- شیت با لینک -->
<div id="refOverlay" class="ref-overlay" hidden></div>
<div id="refSheet" class="ref-sheet" role="dialog" aria-modal="true">
  <div class="ref-sheet-handle"></div>
  <div class="ref-sheet-head">
    <span id="refSheetLabel" class="ref-pill"></span>
    <button type="button" id="refSheetClose" aria-label="বন্ধ করুন">×</button>
  </div>
  <div class="ref-sheet-content">
    <div id="refSheetTitle" class="ref-sheet-title"></div>
    <div id="refSheetDomain" class="ref-sheet-domain"></div>
    <div id="refSheetChips" class="ref-sheet-chips"></div>
  </div>
  <div class="ref-sheet-cta-wrap">
    <button type="button" id="refSheetCTA" class="ref-sheet-cta">
      <span>উৎস দেখুন</span><span aria-hidden="true">↗</span>
    </button>
  </div>
</div>

<!-- شیت بدون لینک (منبع چاپی) -->
<div id="refOverlayNL" class="ref-overlay ref-overlay-nl" hidden></div>
<div id="refCardNL" class="ref-card-nl" role="dialog" aria-modal="true">
  <div class="ref-sheet-handle"></div>
  <button type="button" id="refCardNLClose" aria-label="বন্ধ করুন">×</button>
  <div class="ref-card-nl-body">
    <div class="ref-card-nl-icon" aria-hidden="true">📖</div>
    <div id="refCardNLLabel" class="ref-card-nl-label"></div>
    <div id="refCardNLTitle" class="ref-card-nl-title"></div>
    <div class="ref-card-nl-rule"></div>
    <div id="refCardNLCite" class="ref-card-nl-cite"></div>
    <div class="ref-card-nl-foot">মুদ্রিত উৎস — এর কোনো অনলাইন লিঙ্ক নেই</div>
  </div>
</div>

<style>
  /* ===== فهرست منابع ===== */
  .ref-bibliography {
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-3);
  }
  .ref-biblio-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-3) 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
  }
  .ref-arrow { color: var(--color-muted); transition: transform 0.2s; }
  .ref-biblio-toggle[aria-expanded="true"] .ref-arrow { transform: rotate(180deg); }
  .ref-biblio-body ol { list-style: none; margin: var(--space-1) 0 var(--space-4); padding: 0; }
  .ref-biblio-body li {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-hairline);
    align-items: flex-start;
    line-height: var(--line-loose);
  }
  .ref-num { color: var(--color-muted); min-width: 26px; white-space: nowrap; }
  .ref-meta { flex: 1; color: var(--color-ink); font-size: var(--text-sm); }
  .ref-year, .ref-domain { color: var(--color-muted); }
  .ref-badge-book {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-style: normal;
    color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 10%, var(--color-bg));
    border: 1px solid color-mix(in srgb, var(--color-accent-2) 25%, transparent);
    border-radius: 999px;
    padding: 1px var(--space-2);
  }
  .ref-backlink {
    color: var(--color-link-ref);
    font-size: var(--text-xs);
    text-decoration: none;
    margin-inline-start: 4px;
  }
  .ref-backlink:hover { text-decoration: underline; }
  :global(.ref-marker.is-flash) {
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 3px;
  }

  /* ===== نشانگر شماره‌ی مرجع داخل متن (از parse-references.js می‌آد) ===== */
  :global(.ref-marker) {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-link-ref);
    cursor: pointer;
    font: inherit;
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
  }
  :global(.ref-marker.is-active) {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    border-radius: 3px;
  }
  /* منابع چاپی (بدون لینک) از همون داخل متن هم با یه رنگ متفاوت و
     زیرخط نقطه‌چین (به‌جای رنگ آبی لینک‌ها) مشخص می‌شن — کاربر قبل از
     کلیک هم می‌فهمه این منبع رابط ندارد. */
  :global(.ref-marker--book) {
    color: var(--color-accent-2);
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  :global(.ref-marker--book.is-active) {
    background: color-mix(in srgb, var(--color-accent-2) 18%, transparent);
    border-radius: 3px;
  }

  /* ===== یادداشت (note) — نشان دایره‌ای «i»، کاملاً متمایز از شماره‌ی
     برنزی منابع؛ با تپ، همون کارت بدون‌لینک منابع (ref-card-nl) با
     محتوای متفاوت باز می‌شه. ===== */
  :global(.note-marker) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--color-accent-2);
    color: #fff;
    border: none;
    padding: 0;
    margin: 0 2px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    vertical-align: super;
    cursor: pointer;
  }
  :global(.note-marker.is-active) {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-2) 25%, transparent);
  }

  /* ===== شیت با لینک ===== */
  .ref-overlay {
    position: fixed; inset: 0;
    background: var(--color-overlay);
    z-index: 9998;
  }
  .ref-sheet {
    position: fixed; left: 0; right: 0; bottom: 0;
    background: var(--color-bg);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--shadow-panel);
    z-index: 9999;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(.22,.61,.36,1);
  }
  .ref-sheet.is-open, .ref-card-nl.is-open { transform: translateY(0); }
  .ref-sheet-handle {
    width: 38px; height: 4px; border-radius: 999px;
    background: var(--color-hairline);
    margin: var(--space-3) auto 0;
    flex-shrink: 0;
  }
  .ref-sheet-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-3) var(--space-5) 0;
    flex-shrink: 0;
  }
  .ref-pill {
    font-size: var(--text-xs); font-weight: 700;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
    padding: 4px var(--space-3);
    border-radius: 999px;
  }
  #refSheetClose, #refCardNLClose {
    background: var(--color-panel);
    border: none;
    width: 30px; height: 30px;
    border-radius: 50%;
    font-size: var(--text-xl);
    color: var(--color-muted);
    cursor: pointer;
    line-height: 1;
    display: flex; align-items: center; justify-content: center;
  }
  .ref-sheet-content { padding: var(--space-4) var(--space-5) 0; overflow-y: auto; flex: 1; }
  .ref-sheet-title { font-size: var(--text-lg); font-weight: 800; color: var(--color-ink); line-height: var(--line-normal); }
  .ref-sheet-domain { font-size: var(--text-xs); color: var(--color-muted); margin-top: var(--space-2); }
  .ref-sheet-chips { display: flex; gap: var(--space-2); margin-top: var(--space-4); flex-wrap: wrap; }
  .ref-chip {
    display: flex; align-items: center; gap: 6px;
    background: var(--color-panel);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .ref-sheet-cta-wrap { padding: var(--space-5); flex-shrink: 0; }
  .ref-sheet-cta {
    display: flex; align-items: center; justify-content: center; gap: var(--space-2);
    width: 100%;
    padding: var(--space-4);
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: 700;
    font-family: var(--font-body);
    background: var(--color-accent);
    color: #fff;
    cursor: pointer;
  }
  .ref-sheet-cta:hover { background: var(--color-accent-hover); }
  .ref-sheet-cta[disabled] { background: var(--color-hairline); color: var(--color-muted); cursor: not-allowed; }

  /* ===== شیت بدون لینک ===== */
  .ref-card-nl {
    position: fixed; left: 0; right: 0; bottom: 0;
    background: var(--color-bg);
    border-top: 3px solid var(--color-accent-2);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    box-shadow: var(--shadow-panel);
    text-align: center;
    z-index: 9999;
    max-height: 70vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(.22,.61,.36,1);
  }
  #refCardNLClose { position: absolute; top: var(--space-3); inset-inline-end: var(--space-4); }
  /* کارت منبع چاپی عمداً با کارت منبع دیجیتال فرق داره: بدون هیچ دکمه‌ی
     اقدام (CTA)، بدون هیچ چیزی که قابل «باز کردن» باشه — فقط اطلاعات
     کتاب‌شناختی. رنگ زمینه‌ی گرم‌تر (کاغذی) حس متفاوتی از شیت لینک‌دار
     می‌ده تا از همون نگاه اول این تفاوت حس بشه. */
  .ref-card-nl {
    background: color-mix(in srgb, var(--color-accent-2) 4%, var(--color-bg));
  }
  .ref-card-nl-body { padding: var(--space-2) var(--space-6) var(--space-6); }
  .ref-card-nl-icon {
    font-size: 28px;
    line-height: 1;
    margin-bottom: var(--space-2);
    opacity: 0.85;
  }
  .ref-card-nl-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-2);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ref-card-nl-title {
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink);
    line-height: var(--line-normal);
    margin-top: var(--space-2);
  }
  /* متن یادداشت (#noteCardText) همون کلاس .ref-card-nl-title رو با
     منبع چاپی به اشتراک می‌ذاره، اما چون متن یادداشت معمولاً پاراگراف
     بلندتریه، ایتالیک/فونت بزرگ/وسط‌چین برای اون مناسب نیست — این‌جا
     مخصوص #noteCardText override می‌شه، بدون تغییر ظاهر کارت منبع. */
  #noteCardText {
    font-style: normal;
    font-size: var(--text-sm);
    line-height: var(--line-loose);
    text-align: start;
  }
  .ref-card-nl-rule { width: 34px; height: 1px; background: var(--color-accent-2); margin: var(--space-4) auto; }
  .ref-card-nl-cite { font-size: var(--text-sm); color: var(--color-muted); line-height: var(--line-loose); }
  .ref-card-nl-foot {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border-top: 1px dashed var(--color-hairline);
    padding-top: var(--space-3);
  }
</style>

<script data-astro-rerun>
  (function () {
    var hasBooted = false;
    function boot() {
      if (hasBooted) return;
      var refs = JSON.parse((document.getElementById("refData") || {}).textContent || "[]");
      var DB = {};
      refs.forEach(function (r) { DB[r.n] = r; });

      var noteEl = document.getElementById("noteData");
      var notesList = noteEl ? JSON.parse(noteEl.textContent || "[]") : [];
      var noteDB = {};
      notesList.forEach(function (nItem) { noteDB[nItem.n] = nItem; });

      var markers = document.querySelectorAll(".ref-marker");
      var noteMarkers = document.querySelectorAll(".note-marker");
      hasBooted = true;
      if (!markers.length && !noteMarkers.length) return;

      var overlay = document.getElementById("refOverlay");
      var sheet = document.getElementById("refSheet");
      var cta = document.getElementById("refSheetCTA");
      var overlayNL = document.getElementById("refOverlayNL");
      var cardNL = document.getElementById("refCardNL");
      var overlayNote = document.getElementById("noteOverlay");
      var cardNote = document.getElementById("noteCard");
      var active = null;

      function chip(label) {
        var el = document.createElement("span");
        el.className = "ref-chip";
        el.textContent = label;
        return el;
      }

      function openSheet(btn, r) {
        if (active) active.classList.remove("is-active");
        active = btn; btn.classList.add("is-active");
        document.getElementById("refSheetLabel").textContent = "সূত্র " + r.n;
        document.getElementById("refSheetTitle").textContent = r.title || r.domain || "শিরোনাম নেই";
        document.getElementById("refSheetDomain").textContent = r.domain || "";
        var chips = document.getElementById("refSheetChips");
        chips.innerHTML = "";
        chips.appendChild(chip(r.author || "অজানা উৎস"));
        chips.appendChild(chip(r.year || "তারিখ নেই"));

        // نکته: url فقط این‌جا، لحظه‌ی باز شدن، به یه closure داده می‌شه —
        // هیچ‌وقت به‌عنوان href روی DOM نمی‌شینه.
        if (r.hasLink) {
          cta.disabled = false;
          cta.onclick = function () { window.open(r.url, "_blank", "noopener"); };
        } else {
          cta.disabled = true;
          cta.onclick = null;
        }

        overlay.hidden = false;
        requestAnimationFrame(function () { sheet.classList.add("is-open"); });
      }
      function closeSheet() {
        sheet.classList.remove("is-open");
        setTimeout(function () { overlay.hidden = true; }, 300);
        if (active) { active.classList.remove("is-active"); active = null; }
      }

      var activeNL = null;
      function openNoLink(btn, r) {
        if (activeNL) activeNL.classList.remove("is-active");
        activeNL = btn; btn.classList.add("is-active");
        document.getElementById("refCardNLLabel").textContent = "সূত্র নম্বর " + r.n;
        document.getElementById("refCardNLTitle").textContent = r.title || "শিরোনাম নেই";
        document.getElementById("refCardNLCite").textContent =
          (r.author || "অজানা উৎস") + " · " + (r.year || "তারিখ নেই");
        overlayNL.hidden = false;
        requestAnimationFrame(function () { cardNL.classList.add("is-open"); });
      }
      function closeNoLink() {
        cardNL.classList.remove("is-open");
        setTimeout(function () { overlayNL.hidden = true; }, 300);
        if (activeNL) { activeNL.classList.remove("is-active"); activeNL = null; }
      }

      // یادداشت: همون کارت بدون‌لینک منابع، ولی با محتوای متن یادداشت —
      // ارقام بنگالی عددش رو نشون می‌ده تا با فهرست «টীকা» ته
      // مقاله قابل‌ردیابی باشه.
      var bnDigits = ["০","১","২","৩","৪","৫","৬","৭","৮","৯"];
      function toBengaliNum(num) {
        return String(num).split("").map(function (d) { return bnDigits[+d] !== undefined ? bnDigits[+d] : d; }).join("");
      }
      var activeNote = null;
      function openNote(btn, note) {
        if (activeNote) activeNote.classList.remove("is-active");
        activeNote = btn; btn.classList.add("is-active");
        document.getElementById("noteCardLabel").textContent = "টীকা " + toBengaliNum(note.n);
        document.getElementById("noteCardText").textContent = note.text || "";
        overlayNote.hidden = false;
        requestAnimationFrame(function () { cardNote.classList.add("is-open"); });
      }
      function closeNote() {
        cardNote.classList.remove("is-open");
        setTimeout(function () { overlayNote.hidden = true; }, 300);
        if (activeNote) { activeNote.classList.remove("is-active"); activeNote = null; }
      }
      function noteCardIsOpen() { return cardNote.classList.contains("is-open"); }

      function sheetIsOpen() { return sheet.classList.contains("is-open"); }
      function cardIsOpen() { return cardNL.classList.contains("is-open"); }

      markers.forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          var r = DB[btn.dataset.ref];
          if (!r) return;

          // کلیک دوباره روی همون شماره‌ای که پاپ‌آپش الان بازه → ببندش (toggle)
          // نکته‌ی کلیدی: تشخیص «لینک‌دار بودن» از روی r.hasLink (که از
          // دامنه‌ی واقعاً پارس‌شده در parse-references.js می‌آد) انجام
          // می‌شه، نه از روی خودِ r.url. چون بعضی منابع چاپی (کتاب) توی
          // ادیتور یه href جایگزین/ناقص (مثل «#») دارن که به‌تنهایی truthy
          // است ولی هیچ مقصد واقعی‌ای نداره — قبلاً همین باعث می‌شد دکمه‌ی
          // «زیارة المصدر» برای کتاب‌ها هم (بی‌فایده) نشون داده بشه.
          closeNote();
          if (r.hasLink) {
            if (active === btn && sheetIsOpen()) { closeSheet(); return; }
            closeNoLink();
            openSheet(btn, r);
          } else {
            if (activeNL === btn && cardIsOpen()) { closeNoLink(); return; }
            closeSheet();
            openNoLink(btn, r);
          }
        });
      });

      noteMarkers.forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          var note = noteDB[btn.dataset.note];
          if (!note) return;
          if (activeNote === btn && noteCardIsOpen()) { closeNote(); return; }
          closeSheet();
          closeNoLink();
          openNote(btn, note);
        });
      });

      // فلش‌های برگشت (↑) در فهرست منابع و فهرست الملاحظات: اسکرول نرم
      // به همون نقطه از متن + یه فلاش رنگی کوتاه روی شماره برای پیدا
      // کردن راحت‌تر
      document.querySelectorAll(".ref-backlink").forEach(function (link) {
        link.addEventListener("click", function (e) {
          e.preventDefault();
          var target = document.getElementById(link.dataset.target);
          if (!target) return;
          target.scrollIntoView({ behavior: "smooth", block: "center" });
          target.classList.add("is-flash");
          setTimeout(function () { target.classList.remove("is-flash"); }, 1200);
        });
      });

      document.getElementById("refSheetClose").addEventListener("click", closeSheet);
      document.getElementById("refCardNLClose").addEventListener("click", closeNoLink);
      document.getElementById("noteCardClose").addEventListener("click", closeNote);
      overlay.addEventListener("click", closeSheet);
      overlayNL.addEventListener("click", closeNoLink);
      overlayNote.addEventListener("click", closeNote);
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") { closeSheet(); closeNoLink(); closeNote(); }
      });

      // نکته‌ی مهم: وقتی هم منابع و هم ملاحظات وجود دارن، دو بخش
      // «.ref-biblio-toggle/body» جدا روی صفحه هست. querySelector تکی
      // فقط اولی (منابع) رو پیدا می‌کرد و دومی (الملاحظات) هیچ‌وقت
      // event listener نمی‌گرفت — برای همین باز نمی‌شد. querySelectorAll
      // + پیدا کردن body مخصوص همون section این رو درست می‌کنه.
      document.querySelectorAll(".ref-biblio-toggle").forEach(function (toggle) {
        var section = toggle.closest("section");
        var body = section ? section.querySelector(".ref-biblio-body") : null;
        if (!body) return;
        toggle.addEventListener("click", function () {
          var open = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!open));
          body.hidden = open;
        });
      });
    }

    // چون این کامپوننت توی هر صفحه‌ی مقاله دوباره تزریق می‌شه ولی با
    // ViewTransitions ممکنه بعضی مرورگرها اسکریپت رو دوباره اجرا نکنن،
    // علاوه بر DOMContentLoaded به astro:page-load هم گوش می‌دیم تا بعد
    // از هر جابه‌جایی بین مقالات (بدون رفرش کامل) هم پاپ‌آپ درست کار کنه.
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
    else boot();
    document.addEventListener("astro:page-load", boot);
  })();
</script>
