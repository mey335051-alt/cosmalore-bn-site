---
// یک‌بار نوشته می‌شه، همه‌جا (صفحه‌ی اصلی/جستجو/مقالات مرتبط) صدا زده می‌شه
interface Props {
  slug: string;
  path?: string | null; // آدرس کامل واقعی مقاله (مثل ar/2026/08/28/xyz)؛ اگه نبود، به slug برمی‌گردیم
  title: string;
  excerpt: string;
  category?: string;
  image?: string;
  imageSrcset?: string | null;
  priority?: boolean; // فقط برای اولین کارت هر صفحه true بدید (کاندید LCP)
}

const { slug, path, title, excerpt, category, image, imageSrcset, priority = false } = Astro.props;
// همون منطق قبلی encodeURIComponent(slug) رو حفظ می‌کنیم، فقط این بار
// روی تک‌تک بخش‌های مسیر (چون بعضی بخش‌ها عربی/غیر-ASCII هستن).
//
// نکته‌ی مهم (رفع مشکل ایندکس گوگل): build.format این پروژه "directory"ه،
// یعنی آدرس واقعی/canonical هر مقاله همیشه با اسلش پایانی تمومه
// (مثلاً /ar/2026/09/25/australia/). قبلاً این‌جا اسلش آخر رو نمی‌ذاشتیم،
// یعنی تقریباً هر لینک داخلی سایت (کارت‌های «مقالات مرتبط»/«مقالات
// أخرى» که در هر صفحه‌ی مقاله تکرار می‌شن) به نسخه‌ی بدون‌اسلش اشاره
// می‌کرد؛ کلادفلر برای این نسخه یه ریدایرکت ۳۰۱ به نسخه‌ی درست
// (با اسلش) می‌فرسته. گوگل هم دقیقاً همین رو در Search Console به‌عنوان
// «Page with redirect» / ایندکس‌نشده گزارش می‌کرد. اضافه‌کردن همین
// اسلش پایانی این مشکل رو (همراه با همون تغییر در sitemap.xml.js،
// Header.astro و search.astro) حل می‌کنه.
const href = path
  ? `/${path.split("/").map(encodeURIComponent).join("/")}/`
  : `/${encodeURIComponent(slug)}/`;
---

<a href={href} class="article-card">
  {image && (
    <div class="img-wrap">
      <img
        src={image}
        srcset={imageSrcset || undefined}
        sizes="(max-width: 640px) 100vw, 320px"
        alt=""
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        width="320"
        height="180"
      />
    </div>
  )}
  <div class="card-body">
    {category && <span class="category-tag">{category}</span>}
    <h3 class="card-title">{title}</h3>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
  </div>
</a>

<style>
  .article-card {
    display: block;
    background: var(--color-panel);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .article-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .article-card .img-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .card-body {
    padding: var(--space-4);
  }

  .category-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    color: #fff;
    background: var(--color-accent-2);
    padding: 2px var(--space-2);
    border-radius: 999px;
    margin-bottom: var(--space-2);
  }

  .card-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-1);
    line-height: var(--line-tight);
  }

  .card-excerpt {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
